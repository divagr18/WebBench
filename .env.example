# EchoBench reads ONLY the provider key for the provider you select.
# Copy to .env and fill in. Never commit a real key.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Gemini (OpenAI-compatible endpoint; implicit context caching is automatic)
GEMINI_API_KEY=your-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low

# OpenAI (Luna). reasoning_effort 'none' uses /v1/chat/completions (frozen pilot
# protocol); 'low'/'high'/etc. route through /v1/responses because that endpoint
# is required to combine function tools with reasoning.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none

# Meta Muse Spark (OpenAI-compatible). Standard tier: muse-spark-1.2 at
# $1.25/$4.25 per M. Contributor tier (training opt-in): muse-spark-1.2-contributor
# at $0.10/$0.20 — used by the pilot, NOT list pricing. Muse rejects reasoning 'none'.
MUSE_API_KEY=your-key-here
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.2
MUSE_REASONING_EFFORT=minimal

# xAI Grok (OpenAI-compatible). Reasoning cannot be disabled; 'low' is the floor.
GROK_API_KEY=your-key-here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.6
GROK_REASONING_EFFORT=low

# ModelScope Qwen 3.7 (existing route). Thinking is disabled unless explicitly enabled.
MODELSCOPE_API_KEY=your-key-here
MODELSCOPE_BASE_URL=https://api-inference.modelscope.ai/v1
MODELSCOPE_MODEL=Qwen-Ambassador/Qwen3.7-Max

# Alibaba workspace / DashScope Qwen3.8 Max Preview. `low` is a model-native
# thinking level; do not combine reasoning_effort with thinking_budget.
DASHSCOPE_API_KEY=your-key-here
DASHSCOPE_BASE_URL=https://your-workspace.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-max-preview
DASHSCOPE_REASONING_EFFORT=low

# Sarvam AI (native). Chat completions via https://api.sarvam.ai/v1
# Models: sarvam-105b (128K, reasoning), sarvam-105b-conversations (voice), plus Gemma-4 31B / GLM 5.2 via same gateway
SARVAM_API_KEY=sk-your-key-here
sarvam_api_key=sk-your-key-here
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b
SARVAM_REASONING_EFFORT=medium
